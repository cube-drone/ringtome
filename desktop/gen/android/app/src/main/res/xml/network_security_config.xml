<?xml version="1.0" encoding="utf-8"?>
<!-- The window loads the node inside the app at http://127.0.0.1:<port> (desktop/src/lib.rs), and
     Android refuses cleartext http by default: allowed for the loopback address and nothing else.
     It outranks the template's all-or-nothing usesCleartextTraffic, which stays false in release. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
