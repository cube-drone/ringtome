{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horse Drawing Tycoon 2",
  "version": "0.1.13",
  "identifier": "net.lassam.ringtome",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A place to keep and share what you make.",
    "longDescription": "Horse Drawing Tycoon 2: a game about drawing horses, with your own node on the Ringtome peer-to-peer social network running inside it.",
    "copyright": "Copyright (c) 2026 Curtis Lassam",
    "category": "SocialNetworking",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
