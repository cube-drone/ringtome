{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ringtome",
  "version": "0.0.1",
  "identifier": "net.lassam.ringtome",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A place to keep and share what you make.",
    "longDescription": "Ringtome: your own node on a peer-to-peer social network, running on your own computer.",
    "copyright": "Copyright (c) 2026 Curtis Lassam",
    "category": "SocialNetworking",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
