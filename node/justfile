# Ringtome node - common automation.
# Run `just` with no arguments to list recipes.

# Use bash for all recipes (this repo is developed under Git Bash on Windows).
set shell := ["bash", "-uc"]
# Don't let MSYS mangle Windows-style args (e.g. taskkill's -F/-IM).
set windows-shell := ["bash", "-uc"]

# Paths are relative to this justfile (the `node/` dir); step up for cargo commands.
workspace := justfile_directory() / ".."
test_data := "./data/test"

# --- ports: one band per checkout, three lanes inside it -------------------------------------
#
# Nothing here talks to a backing service, so "can these two runs coexist?" is entirely a
# question of which ports they bind. Two independences are wanted and this buys both:
#
#   * `just integration` / `just ci` must not disturb `just start*`. They used to share
#     5281-5283, which is why integration had to kill the dev network first - the tests and the
#     playground were fighting over the same three sockets. Now they are different lanes and
#     neither has any reason to touch the other.
#   * Two checkouts on one machine must not disturb each other. This replaces the old
#     `*ringtome-alt* -> +500` special case, which handled exactly two copies and only if the
#     second was named right.
#
# The band is derived from the checkout's own path, so it is stable across reboots and across
# whichever directory you happen to invoke `just` from, and needs no state on disk. Different
# checkout, different band, no coordination. Two checkouts CAN collide (64 slots, a hash); the
# escape hatch is `RINGTOME_PORT_SLOT=<n>` in your shell. `just ports` prints the whole map.
#
# Layout inside a 32-port band, and the reason for each floor:
#
#   base+1  .. base+16   dev network   `just start`, `start-two/three`, `start-n` (N<=16)
#   base+17 .. base+19   scratch       `just scratch` - throwaway probe nodes
#   base+20              (firebreak)   deliberately unbound
#   base+21 .. base+24   integration   `just integration` - alpha, bravo, charlie, delta
#   base+25 .. base+31   spare
#
# NOTE: `{{ }}` is NOT interpolated inside backticks - a backtick would see the literal text and
# silently hash a constant, giving every checkout the same band. `shell()` takes real arguments
# and is the reason this works at all.
port_slot := env_var_or_default("RINGTOME_PORT_SLOT", shell('printf %s "$1" | cksum | cut -d" " -f1', justfile_directory()))
port_base := shell('echo $(( 5280 + ($1 % 64) * 32 ))', port_slot)

# The dev network's first three nodes, named because the recipes reach for them by hand.
port := shell('echo $(( $1 + 1 ))', port_base)
port_b := shell('echo $(( $1 + 2 ))', port_base)
port_c := shell('echo $(( $1 + 3 ))', port_base)

# The integration rig's four. The fourth is the DARK node: no RINGTOME_DISCOVERY at all, which is
# the default a shipped node boots with. Every other rig node runs `local:` discovery, so nothing
# exercised the dark path until a 500 on /serve turned up in test-data (2026-08-08).
int_a := shell('echo $(( $1 + 21 ))', port_base)
int_b := shell('echo $(( $1 + 22 ))', port_base)
int_c := shell('echo $(( $1 + 23 ))', port_base)
int_d := shell('echo $(( $1 + 24 ))', port_base)
# The fifth integration node (echo), on the spare lane past mainline-smoke's +25/+26: the
# 4-hop cascade tests need four p2p-capable nodes, and delta - deliberately dark - cannot
# dial or be dialled, which is its whole job.
int_e := shell('echo $(( $1 + 27 ))', port_base)

# List available recipes.
default:
    @just --list

# --- install ---------------------------------------------------------------

# Install every dependency the app needs to run (assumes node and rust already
# exist): npm packages for the UI and the integration harness, and the Rust
# workspace's crates via cargo fetch (downloads only - `just build` compiles).
install: ui-install integration-install
    cd "{{workspace}}" && cargo fetch

# --- build / check ---------------------------------------------------------

# Compile the workspace (debug).
build:
    cd "{{workspace}}" && cargo build

# Fast type-check without producing a binary.
check:
    cd "{{workspace}}" && cargo check

# Clippy lints, warnings-as-errors - ALL targets, tests included (2026-08-08). Test code is
# where the proof lives, and it was the one place nothing was gated: sixteen real lint
# failures had accumulated in test modules without CI ever looking. Genuinely exceptional
# cases carry an inline `#[allow]` with the reason, which is a decision on the record rather
# than a silence.
lint:
    cd "{{workspace}}" && cargo clippy --all-targets -- -D warnings

# Format all Rust code.
fmt:
    cd "{{workspace}}" && cargo fmt

# Rust unit tests.
# Full output teed to /tmp so any failure's `failures:` block survives the run even when a
# pipe or scrolled terminal eats it. (Installed to hunt the once-in-many-runs phantom flake,
# which it caught on 2026-07-25: a temp-dir clock collision in db tests, since fixed. Kept -
# it costs nothing and the next phantom won't announce itself either.)
test-unit:
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    cargo test --no-fail-fast 2>&1 | tee /tmp/ringtome-test-unit.log
    exit "${PIPESTATUS[0]}"

# --- run -------------------------------------------------------------------

# Run the node in the foreground (Ctrl-C to stop). Uses the default data dir.
run:
    cd "{{workspace}}" && RINGTOME_PORT={{port}} cargo run --bin ringtome

# Boot the server + UI watchers in one terminal. Ctrl-C tears everything down.
start: ui-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"

    # ensure esbuild output dirs exist
    mkdir -p node/js/target/js node/js/target/css

    # initial build so the server has bundles to include_str! on first compile
    cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --sourcemap --keep-names && \
                  npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'
    cd "{{workspace}}"

    # JS watcher
    (cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser \
        --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" \
        --log-level=info --legal-comments=inline) &
    JS_PID=$!

    # CSS watcher
    (cd node/js && npx esbuild index.css --bundle --outfile=target/css/bundle.css \
        --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch) &
    CSS_PID=$!

    cleanup() {
        echo ""
        echo "shutting down..."
        kill "$JS_PID" "$CSS_PID" 2>/dev/null || true
        wait "$JS_PID" "$CSS_PID" 2>/dev/null || true
        echo "done."
    }
    trap cleanup EXIT

    # Rust server (foreground — Ctrl-C lands here first), on this checkout's dev port.
    echo "node A on http://localhost:{{port}}"
    RINGTOME_PORT={{port}} cargo run --bin ringtome

# Two dev nodes on one machine, one Ctrl-C: the adoption-ceremony playground. Node A on the dev
# port (default data dir, hostname name), node B on the next one (./data-b, named
# "second-brain"), sharing a local discovery folder so post-adoption background sync can find
# addresses. Create a persona on A, register a fresh account on B, carry the codes between tabs.
# Both recipes print their URLs; `just ports` shows this checkout's whole band.
#
# Two dev nodes, one Ctrl-C: the adoption-ceremony playground.
start-two: ui-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"

    mkdir -p node/js/target/js node/js/target/css

    # initial build so the servers have bundles to include_str! on first compile
    cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --sourcemap --keep-names && \
                  npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'
    cd "{{workspace}}"

    # JS watcher
    (cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser \
        --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" \
        --log-level=info --legal-comments=inline) &
    JS_PID=$!

    # CSS watcher
    (cd node/js && npx esbuild index.css --bundle --outfile=target/css/bundle.css \
        --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch) &
    CSS_PID=$!

    # Build once so the two `cargo run`s below don't race the compiler.
    cargo build --bin ringtome

    # Node B in the background, logs to /tmp (its terminal noise would interleave with A's).
    node_b_port={{port_b}}
    RINGTOME_PORT="$node_b_port" RINGTOME_DATA_DIRECTORY=./data-b RINGTOME_NODE_NAME=second-brain \
        RINGTOME_DISCOVERY=local:./data-dht \
        cargo run --bin ringtome > /tmp/ringtome-second-brain.log 2>&1 &
    NODE_B_PID=$!
    echo "node B (second-brain) on http://localhost:$node_b_port — logs: /tmp/ringtome-second-brain.log"

    cleanup() {
        echo ""
        echo "shutting down..."
        kill "$JS_PID" "$CSS_PID" "$NODE_B_PID" 2>/dev/null || true
        wait "$JS_PID" "$CSS_PID" "$NODE_B_PID" 2>/dev/null || true
        echo "done."
    }
    trap cleanup EXIT

    # Node A on the dev port (plus the twin offset) in the foreground — Ctrl-C lands here and
    # takes everything down.
    echo "node A on http://localhost:{{port}}"
    RINGTOME_PORT={{port}} RINGTOME_DISCOVERY=local:./data-dht cargo run --bin ringtome

# Three dev nodes, one Ctrl-C: the daisy-chain playground. A on the dev port (hostname name),
# B "second-brain" next (./data-b), C "third-brain" after that (./data-c), shared local
# discovery. Found a persona on A, invite B from A, then invite C *from B* - the un-trimmed
# junior grant: the chain of computers doesn't route through the founder. (On the ringtome-alt
# Each prints its URL; `just ports` shows the band.)
#
# Three dev nodes, one Ctrl-C: the daisy-chain playground.
start-three: ui-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"

    mkdir -p node/js/target/js node/js/target/css

    # initial build so the servers have bundles to include_str! on first compile
    cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --sourcemap --keep-names && \
                  npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'
    cd "{{workspace}}"

    # JS watcher
    (cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser \
        --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" \
        --log-level=info --legal-comments=inline) &
    JS_PID=$!

    # CSS watcher
    (cd node/js && npx esbuild index.css --bundle --outfile=target/css/bundle.css \
        --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch) &
    CSS_PID=$!

    # Build once so the three `cargo run`s below don't race the compiler.
    cargo build --bin ringtome

    # Node B in the background, logs to /tmp (its terminal noise would interleave with A's).
    node_b_port={{port_b}}
    RINGTOME_PORT="$node_b_port" RINGTOME_DATA_DIRECTORY=./data-b RINGTOME_NODE_NAME=second-brain \
        RINGTOME_DISCOVERY=local:./data-dht \
        cargo run --bin ringtome > /tmp/ringtome-second-brain.log 2>&1 &
    NODE_B_PID=$!
    echo "node B (second-brain) on http://localhost:$node_b_port — logs: /tmp/ringtome-second-brain.log"

    node_c_port={{port_c}}
    RINGTOME_PORT="$node_c_port" RINGTOME_DATA_DIRECTORY=./data-c RINGTOME_NODE_NAME=third-brain \
        RINGTOME_DISCOVERY=local:./data-dht \
        cargo run --bin ringtome > /tmp/ringtome-third-brain.log 2>&1 &
    NODE_C_PID=$!
    echo "node C (third-brain) on http://localhost:$node_c_port — logs: /tmp/ringtome-third-brain.log"

    cleanup() {
        echo ""
        echo "shutting down..."
        kill "$JS_PID" "$CSS_PID" "$NODE_B_PID" "$NODE_C_PID" 2>/dev/null || true
        wait "$JS_PID" "$CSS_PID" "$NODE_B_PID" "$NODE_C_PID" 2>/dev/null || true
        echo "done."
    }
    trap cleanup EXIT

    # Node A on the dev port (plus the twin offset) in the foreground — Ctrl-C lands here and
    # takes everything down.
    echo "node A on http://localhost:{{port}}"
    RINGTOME_PORT={{port}} RINGTOME_DISCOVERY=local:./data-dht cargo run --bin ringtome

# Boot N dev nodes in one terminal, one Ctrl-C: the generalized playground. Node A on the dev
# port (default data dir, hostname name), then "node-2" (./data-2), "node-3" (./data-3), ...
# through node-N on base+N (./data-N) — N is capped at 16 because the dev LANE is base+1..base+16,
# and 17 would land on the scratch floor. All share a local discovery folder so post-adoption
# sync can find addresses. N=1 is a bare `start`; the default N=3 is a `start-three`. Create a
# persona on A, register fresh accounts at the others, carry the codes between tabs.
#
# Boot N dev nodes (1-16) in one terminal, one Ctrl-C.
start-n n="3": ui-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"

    n="{{n}}"
    if ! [[ "$n" =~ ^[0-9]+$ ]] || [ "$n" -lt 1 ] || [ "$n" -gt 16 ]; then
        echo "start-n: n must be an integer from 1 to 16 (got '$n')" >&2
        exit 1
    fi

    # Shared local discovery so post-adoption background sync can find addresses. A lone node
    # (n=1) has no peers to find, so it goes bare like `just start`.
    discovery="local:./data-dht"
    [ "$n" -ge 2 ] || discovery=""

    # ensure esbuild output dirs exist
    mkdir -p node/js/target/js node/js/target/css

    # initial build so the servers have bundles to include_str! on first compile
    cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --sourcemap --keep-names && \
                  npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'
    cd "{{workspace}}"

    # JS watcher
    (cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser \
        --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" \
        --log-level=info --legal-comments=inline) &
    JS_PID=$!

    # CSS watcher
    (cd node/js && npx esbuild index.css --bundle --outfile=target/css/bundle.css \
        --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch) &
    CSS_PID=$!

    # Build once so the N `cargo run`s below don't race the compiler.
    cargo build --bin ringtome

    # Nodes 2..N in the background, logs to /tmp (their terminal noise would interleave with A's).
    node_pids=""
    for ((i = 2; i <= n; i++)); do
        port=$(( {{port_base}} + i ))
        RINGTOME_PORT="$port" RINGTOME_DATA_DIRECTORY="./data-$i" RINGTOME_NODE_NAME="node-$i" \
            RINGTOME_DISCOVERY="$discovery" \
            cargo run --bin ringtome > "/tmp/ringtome-node-$i.log" 2>&1 &
        node_pids="$node_pids $!"
        echo "node $i (node-$i) on http://localhost:$port — data ./data-$i — logs: /tmp/ringtome-node-$i.log"
    done

    cleanup() {
        echo ""
        echo "shutting down..."
        kill "$JS_PID" "$CSS_PID" $node_pids 2>/dev/null || true
        wait "$JS_PID" "$CSS_PID" $node_pids 2>/dev/null || true
        echo "done."
    }
    trap cleanup EXIT

    # Node A on the dev port (plus the twin offset) in the foreground — Ctrl-C lands here and
    # takes everything down.
    echo "node A on http://localhost:{{port}}"
    RINGTOME_PORT={{port}} RINGTOME_DISCOVERY="$discovery" cargo run --bin ringtome

# --- ui -----------------------------------------------------------------------

# Install JS dependencies for the Preact UI.
ui-install:
    cd "{{justfile_directory()}}/js" && npm install

# Production build of the Preact UI (JS + CSS bundles).
ui-build:
    cd "{{justfile_directory()}}/js" && mkdir -p target/js target/css && npx esbuild index.js --bundle --tree-shaking=true --metafile=target/js/meta.json --outfile=target/js/bundle.js --platform=browser --minify && npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'

# Watch-rebuild the JS bundle on save (run in a separate terminal).
ui-watch:
    cd "{{justfile_directory()}}/js" && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" --log-level=info --legal-comments=inline

# The JS-side gate: rebuild the bundles, then run the UI's pure-module tests.
#
# Rebuilding is half the value. esbuild is the only thing type-checking the UI - there is no
# tsc and (yet) no eslint - and `src/ui.rs` bakes the bundles in with `include_str!` while
# `js/target/` is gitignored, so until this has run NOTHING Rust compiles on a fresh clone and a
# stale bundle silently compiles on an old one. That is why the GitHub action builds the UI before
# `just ci`, and why `ci` now depends on this instead of assuming someone did.
#
# `integration/test/pure/` is the home for tests that need nothing - no browser, no node, no HTTP -
# which is exactly the UI's pure core. Living in their own directory means this gate is glob-driven:
# a new pure-module test is picked up by existing there, never by being added to a list here. (They
# also still run inside the full integration suite, whose `test/**/*.cjs` spec reaches them.)
#
# `--no-config` is required: .mocharc.json's spec MERGES with CLI args rather than yielding to
# them, so without it this runs the whole suite against nodes nobody booted - the same trap
# `mainline-smoke` documents. The glob is quoted so mocha expands it, not the shell.
#
# What a glob CANNOT catch is a pure module nobody wrote a test for; that is the purity cop's job
# (REFACTOR_UI S1), and this recipe is where it will live.
ui-check: ui-build
    cd "{{justfile_directory()}}/js" && npx eslint .
    cd "{{justfile_directory()}}/integration" && npx mocha --no-config 'test/pure/*.cjs'

# Watch-rebuild the CSS bundle on save (run in a separate terminal).
ui-csswatch:
    cd "{{justfile_directory()}}/js" && npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch

# --- integration tests -----------------------------------------------------

# Install the JS integration-test dependencies.
integration-install:
    cd "{{justfile_directory()}}/integration" && npm install

# Populate the currently-running nodes with a vibrant fake network: N personas per booted
# node (default 15), each performing N actions (default 15) drawn from a weighted hat -
# public posts, follows and trust across nodes, rebroadcasts of each other's posts, private
# notebooks, spreading onto other nodes. Same seed, same network; credentials land in
# harness/testdata-state.json. Extend it
# by adding an entry to ACTIONS in harness/testdata.mjs.
#
# Seed a fake network onto the running nodes (see harness/testdata.mjs; extensible).
test-data personas="15" actions="15" seed="":
    #!/usr/bin/env bash
    set -uo pipefail
    # Preflight the interpreter BEFORE any parse: an old Node dies on modern syntax deep in a
    # dependency, and a stack trace from cssstyle is a riddle where a sentence would do.
    major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
    if [ "$major" -lt 18 ]; then
        echo "test-data needs Node 18+ (global fetch); found $(node --version 2>/dev/null || echo 'no node') at $(which node 2>/dev/null || echo '?')" >&2
        exit 1
    fi
    # Default to the dev network, shifted with the twin like the recipes that spawn the nodes -
    # otherwise the generator would reach into the OTHER checkout's network. An explicit
    # RINGTOME_TESTDATA_PORTS (e.g. scratch nodes) is always honored as given.
    # Which nodes to drive: whatever is ACTUALLY ALIVE in this checkout's dev lane, discovered
    # by asking. This used to name the first three ports outright, which was true when `just
    # start` and `just start-two`/`start-three` were the only ways to boot a network - and
    # quietly wrong from the moment `start-n` arrived, because `just start-n 6` then got a
    # generator that could only see half of it. A probe cannot drift the way a baked list does.
    if [ -z "${RINGTOME_TESTDATA_PORTS-}" ]; then
        live=""
        for ((i = 1; i <= 16; i++)); do
            p=$(( {{port_base}} + i ))
            if curl -sf -m 1 "http://127.0.0.1:$p/health" >/dev/null 2>&1; then
                live="${live:+$live,}$p"
            fi
        done
        if [ -z "$live" ]; then
            echo "test-data: nothing answering on this checkout's dev lane (ports $(( {{port_base}} + 1 ))-$(( {{port_base}} + 16 )))." >&2
            echo "  start a network first: 'just start', or 'just start-n N' for N nodes." >&2
            echo "  (throwaway nodes instead? 'just scratch 1|2|3', then set RINGTOME_TESTDATA_PORTS)" >&2
            exit 1
        fi
        RINGTOME_TESTDATA_PORTS="$live"
        export RINGTOME_TESTDATA_PORTS
    fi
    echo "test-data: driving dev nodes $RINGTOME_TESTDATA_PORTS"
    cd "{{justfile_directory()}}/harness" && node testdata.mjs {{personas}} {{actions}} {{seed}}

# --- scratch nodes (agent/probe testing) ----------------------------------------------------
# Throwaway nodes for harness probes and agent testing, kept STRUCTURALLY apart from the dev
# network: they live in their own lane (base+17..base+19) and in /tmp, and are killed by PID
# file - never by pattern - so no scratch cleanup can ever take down `just start*`. Born from
# the 2026-08-05 incident where a broad pkill killed the running dev trio mid-test and a scratch
# node then squatted the dev port, impersonating it.
#
# The argument is an INDEX (1-3), not a port. It used to be a raw port with a hand-maintained
# list of dev ports it refused; now the lane arithmetic makes an overlap unrepresentable, which
# is the better version of the same guard.

# Boot a throwaway node on scratch slot N (1-3), wait for health, background it. The pid, data
# dir, log and discovery folder are all keyed by the port the node actually BINDS - and bands
# differ per checkout, so two checkouts' scratch fixtures can never collide.
#
# Boot a throwaway probe node on this checkout's scratch slot N (1-3).
scratch n="3":
    #!/usr/bin/env bash
    set -uo pipefail
    case "{{n}}" in
        1|2|3) ;;
        *) echo "scratch takes a slot index 1-3 (got '{{n}}'); the lane is 3 ports wide" >&2; exit 1;;
    esac
    port=$(( {{port_base}} + 16 + {{n}} ))
    cd "{{workspace}}"
    dht="/tmp/ringtome-scratch-dht-{{port_base}}"
    dir="/tmp/ringtome-scratch-$port"
    pidfile="$dir.pid"
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        echo "scratch node already up on :$port (pid $(cat "$pidfile"))"
        exit 0
    fi
    rm -rf "$dir"
    RINGTOME_PORT=$port RINGTOME_DATA_DIRECTORY="$dir" RINGTOME_LOCAL_TEST=1         RINGTOME_DISCOVERY="local:$dht" RINGTOME_SYNC_DEBOUNCE_MS=250         cargo run --bin ringtome > "$dir.log" 2>&1 &
    echo $! > "$pidfile"
    for i in $(seq 1 120); do
        if curl -s -o /dev/null -m 1 "http://localhost:$port/health"; then
            echo "scratch node on :$port (pid $(cat "$pidfile"), data $dir, log $dir.log)"
            echo "  harness probes: export RINGTOME_SCRATCH_{{n}}=http://localhost:$port"
            exit 0
        fi
        sleep 1
    done
    echo "scratch node on :$port never became healthy - see $dir.log" >&2
    exit 1

# Kill this checkout's scratch nodes - by recorded PID only, so a running dev network cannot be
# touched, and scoped to this band, so another checkout's probes cannot be either. (The glob used
# to be every `ringtome-scratch-*.pid` on the machine, which was fine when one checkout existed.)
#
# Kill this checkout's scratch nodes, by recorded PID.
scratch-kill:
    #!/usr/bin/env bash
    set -uo pipefail
    found=0
    for n in 1 2 3; do
        pidfile="/tmp/ringtome-scratch-$(( {{port_base}} + 16 + n )).pid"
        [ -e "$pidfile" ] || continue
        found=1
        pid=$(cat "$pidfile")
        if kill "$pid" 2>/dev/null; then
            for i in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
            echo "killed scratch pid $pid ($pidfile)"
        else
            echo "scratch pid $pid already gone ($pidfile)"
        fi
        rm -f "$pidfile"
    done
    for n in 1 2 3; do rm -rf "/tmp/ringtome-scratch-$(( {{port_base}} + 16 + n ))"* 2>/dev/null || true; done
    rm -rf "/tmp/ringtome-scratch-dht-{{port_base}}" 2>/dev/null || true
    [ "$found" = 1 ] || echo "no scratch nodes recorded for this checkout"

# MACHINE-WIDE BY DESIGN, and now nothing depends on it: `just integration` used to, which is why
# running the tests took the dev network down with them. It is a panic button for a wedged machine,
# not part of any flow, and it reaches ACROSS CHECKOUTS - every other copy of this repo included.
#
# Reach for a scoped one first: `scratch-kill` clears this checkout's probe nodes, and `just
# integration` clears its own leftovers by PID file on the way in.
#
# Kill EVERY running ringtome on this machine, every checkout's included. A panic button.
kill:
    -MSYS2_ARG_CONV_EXCL="*" taskkill -F -IM ringtome.exe 2>/dev/null || pkill -f 'target/debug/ringtome' 2>/dev/null || true

# DESTROY every development database on this machine, and the keys that open them.
#
# This is not "clean the build" - `cargo clean` is that. This deletes the data directories the
# dev recipes write to, which means accounts, personas, their chains, their journals, their
# blobs, and the keystore. Nothing survives it and nothing recovers it: the keystore is what
# decrypts the databases, so removing them together is the only honest option - a database
# without its key refuses to open, on purpose.
#
# What it is FOR: the node refuses to boot after a schema generation bump ("pre-launch there is
# no in-place migration - delete the database and rebuild"). This is that delete.
#
# Covers `start` / `run` (./data, which also contains the integration rig's ./data/test*),
# `start-two` (adds ./data-b, ./data-dht), `start-three` (adds ./data-c) and `start-n` (adds
# ./data-2.. ./data-N, all swept by the data-* glob). Kills any running
# node first, so nothing is holding a file open while it disappears.
#
# DESTROYS every dev persona, key and chain - the wipe a schema generation bump asks for.
#
# The one recipe that still depends on the machine-wide `kill`, and deliberately: it is deleting
# the files out from under whatever is holding them open, and a foreground `just start` in another
# terminal has no pidfile to shoot it by. It only removes THIS checkout's data directories, but it
# will stop other checkouts' nodes on the way past. Ctrl-C your own playgrounds first if that
# matters.
clean: kill
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    for d in data data-*; do
        if [ -e "$d" ]; then
            rm -rf "$d" && echo "removed $d"
        fi
    done
    echo "gone: every persona, key and chain the dev nodes held. The next boot starts empty."

# Boot FOUR throwaway nodes - three on local discovery (sync needs a peer; daisy-chain needs a
# chain) plus one in the DARK, with no directory at all, which is what a shipped node defaults to.
# Wait for health, run the JS integration suite, tear all down. Single-node-only tests are unaffected;
# multi-node tests skip themselves if RINGTOME_TEST_HOST_B / _C are absent.
#
# It does NOT depend on `kill` any more, and that is the point: the rig lives in its own lane
# (base+21..base+24), so a `just start*` playground can be running the whole time and neither
# notices the other. Previously the rig bound the dev ports, so the only way to guarantee they
# were free was to shoot every ringtome on the machine - which took the dev network with it, and
# any other checkout's too. Leftovers from a run that died before its trap are cleared by PID
# file, scoped to this band.
#
# Boot this checkout's four rig nodes, run the JS integration suite, tear them down.
# RINGTOME_TEST_GREP=<pattern> runs only the describes/its whose titles match (mocha --grep),
# still against the full rig - the way to iterate on one file without the 3-minute suite.
integration: build
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    # Every lane the rig boots, and the discovery folder they share. `-e` was missing here until
    # 2026-08-12, so echo's database was the one that SURVIVED between runs - invisible while the
    # schema held still, and a node that refused to boot the first time the generation moved. A
    # node added to the boot list below wants adding here in the same breath.
    rm -rf "{{test_data}}" "{{test_data}}-b" "{{test_data}}-c" "{{test_data}}-d" \
           "{{test_data}}-e" "{{test_data}}-dht"
    pa={{int_a}}
    pb={{int_b}}
    pc={{int_c}}
    pd={{int_d}}
    pe={{int_e}}
    # A previous run that was SIGKILLed (or whose shell died) never ran its trap. Clear only what
    # this band recorded - never by pattern, which is what made the old cleanup machine-wide.
    for p in $pa $pb $pc $pd $pe; do
        stale="/tmp/ringtome-int-$p.pid"
        [ -e "$stale" ] || continue
        pid=$(cat "$stale")
        if kill "$pid" 2>/dev/null; then
            for i in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
            echo "cleared a stale integration node on :$p (pid $pid)"
        fi
        rm -f "$stale"
    done
    # Fast eager-push debounce so eagersync.cjs observes propagation quickly; the anti-entropy
    # interval deliberately stays at its 5-minute default so the eager path is what gets tested.
    # The peer-derive beat keeps its recovery pace on purpose - its lag behind a revocation is
    # the strike's delivery window, and a fast beat races every strike test's choreography.
    # peerderive.cjs rings the beat itself via POST /test/derive when it wants to watch one.
    RINGTOME_PORT=$pa RINGTOME_DATA_DIRECTORY="{{test_data}}" RINGTOME_LOCAL_TEST=1 RINGTOME_SYNC_BUDGET_ENTRIES=60 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        RINGTOME_SYNC_DEBOUNCE_MS=250 RINGTOME_TEST_INBOX_KEEP=4 \
        RINGTOME_TEST_BODY_SWEEP_MS=1500 RINGTOME_TEST_REVALIDATE_MS=500 RINGTOME_TEST_REAP_MS=2000 RINGTOME_TEST_REAP_GRACE_MS=500 RINGTOME_TEST_TREE_ONLY=1 \
        RINGTOME_TEST_FOLLOW_REFRESH_MS=2000 RINGTOME_TEST_FOLLOW_COOLDOWN_MS=1500 RINGTOME_TEST_FOLLOW_STALE_MS=2000 RINGTOME_TEST_JOURNAL_FILL_MS=1000 \
        RINGTOME_TEST_SPECULATIVE_MS=2000 RINGTOME_TEST_SPECULATIVE_COOLDOWN_MS=1500 RINGTOME_TEST_SPECULATIVE_BUDGET=1 \
        RINGTOME_TEST_DIAL_TIMEOUT_MS=1500 RINGTOME_TEST_EVICT_MS=2000 RINGTOME_TEST_EVICT_GRACE_MS=600000 \
        RINGTOME_NODE_NAME=alpha \
        ./target/debug/ringtome > /tmp/ringtome-integration.log 2>&1 &
    NODE_PID=$!
    echo $NODE_PID > "/tmp/ringtome-int-$pa.pid"
    RINGTOME_PORT=$pb RINGTOME_DATA_DIRECTORY="{{test_data}}-b" RINGTOME_LOCAL_TEST=1 RINGTOME_SYNC_BUDGET_ENTRIES=60 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        RINGTOME_SYNC_DEBOUNCE_MS=250 RINGTOME_TEST_INBOX_KEEP=4 \
        RINGTOME_TEST_BODY_SWEEP_MS=1500 RINGTOME_TEST_REVALIDATE_MS=500 RINGTOME_TEST_REAP_MS=2000 RINGTOME_TEST_REAP_GRACE_MS=500 RINGTOME_TEST_TREE_ONLY=1 \
        RINGTOME_TEST_FOLLOW_REFRESH_MS=2000 RINGTOME_TEST_FOLLOW_COOLDOWN_MS=1500 RINGTOME_TEST_FOLLOW_STALE_MS=2000 RINGTOME_TEST_JOURNAL_FILL_MS=1000 \
        RINGTOME_TEST_SPECULATIVE_MS=2000 RINGTOME_TEST_SPECULATIVE_COOLDOWN_MS=1500 RINGTOME_TEST_SPECULATIVE_BUDGET=1 \
        RINGTOME_TEST_DIAL_TIMEOUT_MS=1500 RINGTOME_TEST_EVICT_MS=2000 RINGTOME_TEST_EVICT_GRACE_MS=600000 \
        RINGTOME_NODE_NAME=bravo \
        ./target/debug/ringtome > /tmp/ringtome-integration-b.log 2>&1 &
    NODE_B_PID=$!
    echo $NODE_B_PID > "/tmp/ringtome-int-$pb.pid"
    RINGTOME_PORT=$pc RINGTOME_DATA_DIRECTORY="{{test_data}}-c" RINGTOME_LOCAL_TEST=1 RINGTOME_SYNC_BUDGET_ENTRIES=60 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        RINGTOME_SYNC_DEBOUNCE_MS=250 RINGTOME_TEST_INBOX_KEEP=4 \
        RINGTOME_TEST_BODY_SWEEP_MS=1500 RINGTOME_TEST_REVALIDATE_MS=500 RINGTOME_TEST_REAP_MS=2000 RINGTOME_TEST_REAP_GRACE_MS=500 RINGTOME_TEST_TREE_ONLY=1 \
        RINGTOME_TEST_FOLLOW_REFRESH_MS=2000 RINGTOME_TEST_FOLLOW_COOLDOWN_MS=1500 RINGTOME_TEST_FOLLOW_STALE_MS=2000 RINGTOME_TEST_JOURNAL_FILL_MS=1000 \
        RINGTOME_TEST_SPECULATIVE_MS=2000 RINGTOME_TEST_SPECULATIVE_COOLDOWN_MS=1500 RINGTOME_TEST_SPECULATIVE_BUDGET=1 \
        RINGTOME_TEST_DIAL_TIMEOUT_MS=1500 RINGTOME_TEST_EVICT_MS=2000 RINGTOME_TEST_EVICT_GRACE_MS=600000 \
        RINGTOME_NODE_NAME=charlie \
        ./target/debug/ringtome > /tmp/ringtome-integration-c.log 2>&1 &
    NODE_C_PID=$!
    echo $NODE_C_PID > "/tmp/ringtome-int-$pc.pid"
    # Deliberately WITHOUT RINGTOME_DISCOVERY: a node in the dark, like every default boot.
    RINGTOME_PORT=$pd RINGTOME_DATA_DIRECTORY="{{test_data}}-d" RINGTOME_LOCAL_TEST=1 RINGTOME_SYNC_BUDGET_ENTRIES=60 \
        RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        RINGTOME_SYNC_DEBOUNCE_MS=250 RINGTOME_TEST_INBOX_KEEP=4 \
        RINGTOME_TEST_BODY_SWEEP_MS=1500 RINGTOME_TEST_REVALIDATE_MS=500 RINGTOME_TEST_REAP_MS=2000 RINGTOME_TEST_REAP_GRACE_MS=500 RINGTOME_TEST_TREE_ONLY=1 \
        RINGTOME_TEST_FOLLOW_REFRESH_MS=2000 RINGTOME_TEST_FOLLOW_COOLDOWN_MS=1500 RINGTOME_TEST_FOLLOW_STALE_MS=2000 RINGTOME_TEST_JOURNAL_FILL_MS=1000 \
        RINGTOME_TEST_SPECULATIVE_MS=2000 RINGTOME_TEST_SPECULATIVE_COOLDOWN_MS=1500 RINGTOME_TEST_SPECULATIVE_BUDGET=1 \
        RINGTOME_TEST_DIAL_TIMEOUT_MS=1500 RINGTOME_TEST_EVICT_MS=2000 RINGTOME_TEST_EVICT_GRACE_MS=600000 \
        RINGTOME_NODE_NAME=delta \
        ./target/debug/ringtome > /tmp/ringtome-integration-d.log 2>&1 &
    NODE_D_PID=$!
    echo $NODE_D_PID > "/tmp/ringtome-int-$pd.pid"
    RINGTOME_PORT=$pe RINGTOME_DATA_DIRECTORY="{{test_data}}-e" RINGTOME_LOCAL_TEST=1 RINGTOME_SYNC_BUDGET_ENTRIES=60 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        RINGTOME_SYNC_DEBOUNCE_MS=250 RINGTOME_TEST_INBOX_KEEP=4 \
        RINGTOME_TEST_BODY_SWEEP_MS=1500 RINGTOME_TEST_REVALIDATE_MS=500 RINGTOME_TEST_REAP_MS=2000 RINGTOME_TEST_REAP_GRACE_MS=500 RINGTOME_TEST_TREE_ONLY=1 \
        RINGTOME_TEST_FOLLOW_REFRESH_MS=2000 RINGTOME_TEST_FOLLOW_COOLDOWN_MS=1500 RINGTOME_TEST_FOLLOW_STALE_MS=2000 RINGTOME_TEST_JOURNAL_FILL_MS=1000 \
        RINGTOME_TEST_SPECULATIVE_MS=2000 RINGTOME_TEST_SPECULATIVE_COOLDOWN_MS=1500 RINGTOME_TEST_SPECULATIVE_BUDGET=1 \
        RINGTOME_TEST_DIAL_TIMEOUT_MS=1500 RINGTOME_TEST_EVICT_MS=2000 RINGTOME_TEST_EVICT_GRACE_MS=600000 \
        RINGTOME_NODE_NAME=echo \
        ./target/debug/ringtome > /tmp/ringtome-integration-e.log 2>&1 &
    NODE_E_PID=$!
    echo $NODE_E_PID > "/tmp/ringtome-int-$pe.pid"
    cleanup() {
        if command -v taskkill >/dev/null 2>&1; then
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_B_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_C_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_D_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_E_PID" 2>/dev/null || true
        else
            kill "$NODE_PID" "$NODE_B_PID" "$NODE_C_PID" "$NODE_D_PID" "$NODE_E_PID" 2>/dev/null || true
        fi
        rm -f "/tmp/ringtome-int-$pa.pid" "/tmp/ringtome-int-$pb.pid" \
              "/tmp/ringtome-int-$pc.pid" "/tmp/ringtome-int-$pd.pid"
    }
    trap cleanup EXIT

    # Wait up to ~10s for each node to answer /health.
    for p in $pa $pb $pc $pd $pe; do
        for i in $(seq 1 50); do
            if curl -sf "http://127.0.0.1:$p/health" >/dev/null 2>&1; then
                break
            fi
            sleep 0.2
            if [[ $i -eq 50 ]]; then
                echo "node on :$p did not become healthy; logs:" >&2
                cat /tmp/ringtome-integration.log /tmp/ringtome-integration-b.log /tmp/ringtome-integration-c.log /tmp/ringtome-integration-d.log >&2
                exit 1
            fi
        done
    done

    cd "{{justfile_directory()}}/integration"
    RINGTOME_TEST_HOST="127.0.0.1:$pa" RINGTOME_TEST_HOST_B="127.0.0.1:$pb" \
        RINGTOME_TEST_HOST_C="127.0.0.1:$pc" RINGTOME_TEST_HOST_DARK="127.0.0.1:$pd" \
        RINGTOME_TEST_HOST_E="127.0.0.1:$pe" \
        RINGTOME_TEST_DISCOVERY_DIR="{{workspace}}/{{test_data}}-dht" \
        RINGTOME_TEST_DATA_DIR="{{workspace}}/{{test_data}}" npm test -- ${RINGTOME_TEST_GREP:+--grep "$RINGTOME_TEST_GREP"}

# The mainline field test: two local nodes on RINGTOME_DISCOVERY=mainline, talking to the REAL
# public mainline DHT and n0 relay/DNS infrastructure. Seconds when that infrastructure is
# healthy (pkarr relays + n0 DNS answer in one round trip), with multi-minute retry ceilings for
# when it isn't; needs the open internet, and publishes throwaway records - including this
# machine's public IP - to the public DHT. On demand only (here or the dispatch-only GitHub
# action); never part of `just ci`.
# The test spawns and restarts its own node processes; see test/mainline.cjs for why.
mainline-smoke: build kill integration-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    rm -rf ./data/test-mainline
    cd node/integration
    # --no-config: .mocharc.json's test/**/* spec glob merges with (rather than yields to) CLI
    # file args, which would run the whole suite against nodes this recipe never booted.
    RINGTOME_TEST_MAINLINE=1 RINGTOME_PORT_BASE={{port_base}} npx mocha --no-config test/mainline.cjs --timeout 900000

# --- strings ---------------------------------------------------------------

# Sync js/locales/en.js with the source, both ways. That file is the AUTHORITATIVE English catalog
# - the one place to read the house voice as a whole, the file to edit to change what the app says,
# and the file a translator copies to start a language. This never overwrites its wording: it adds
# keys new in the source, retires keys the source dropped, and rewrites the `t()` / `msg!` seeds at
# the call sites to agree with it. Run it after writing new copy, and after editing en.js.
strings:
    cd "{{workspace}}" && node node/tools/strings.mjs

# The strings cop: fails when en.js is out of step with the source, when a call-site seed disagrees
# with the catalog, when two phrases share a key, or when copy reaches a person WITHOUT going
# through `t`. New copy arrives a phrase at a time inside whichever component needed it, which is
# how a house voice drifts with nobody deciding to change it. This makes new words impossible to
# land silently - they show up in the diff of a file whose whole job is words - and stops the code
# from claiming to say something the app does not say.
strings-check:
    cd "{{workspace}}" && node node/tools/strings.mjs --check

# Wrap every un-wrapped user-facing phrase in `t()` / `msg!`, minting a stable key for each.
# Idempotent: anything already wrapped is invisible to it, so it is safe to re-run.
strings-migrate:
    cd "{{workspace}}" && node node/tools/strings.mjs --migrate

# --- ports -----------------------------------------------------------------

# Print this checkout's port band and what lives in it. The first thing to run when something
# says "address already in use", and the answer to "which localhost am I on today".
#
# Print this checkout's port band: which lane is which, and what to override.
ports:
    #!/usr/bin/env bash
    set -uo pipefail
    echo "checkout     {{justfile_directory()}}"
    echo "slot         $(( {{port_slot}} % 64 ))  (override: RINGTOME_PORT_SLOT=<0-63>)"
    echo "band         {{port_base}}..$(( {{port_base}} + 31 ))"
    echo ""
    echo "dev          :{{port}}..$(( {{port_base}} + 16 ))   just start / start-two / start-three / start-n"
    echo "scratch      :$(( {{port_base}} + 17 ))..$(( {{port_base}} + 19 ))   just scratch 1|2|3"
    echo "integration  :{{int_a}}..{{int_d}}   just integration / just ci"
    echo "spare        :$(( {{port_base}} + 25 ))..$(( {{port_base}} + 31 ))   mainline-smoke takes +25/+26"
    echo ""
    echo "dev and integration are different lanes: a playground can stay up through a full ci run."

# --- everything ------------------------------------------------------------

# Full local check: UI bundles + UI pure tests, then cargo check, clippy, Rust unit tests, and
# the integration suite. `ui-check` runs FIRST because the Rust build embeds its output.
# `strings-check` sits after it: a broken build is more urgent than an un-catalogued sentence.
#
# The whole gate: UI, strings, cargo check, clippy, Rust tests, integration. What CI runs.
ci: ui-check strings-check check lint test-unit integration
