    cleanup() {
        echo ""
        echo "shutting down..."
        kill "$JS_PID" "$CSS_PID" "$NODE_B_PID" "$NODE_C_PID" 2>/dev/null || true
        wait "$JS_PID" "$CSS_PID" "$NODE_B_PID" "$NODE_C_PID" 2>/dev/null || true
        echo "done."
    }
    trap cleanup EXIT

    # Node A on the dev port (plus the twin offset) in the foreground — Ctrl-C lands here and
    # takes everything down.
    RINGTOME_PORT=$((5281 + {{port_offset}})) RINGTOME_DISCOVERY=local:./data-dht cargo run --bin ringtome

# Boot N dev nodes in one terminal, one Ctrl-C: the generalized playground. Node A on :5281
# (default data dir, hostname name), then "node-2" on :5282 (./data-2), "node-3" on :5283
# (./data-3), ... through node-N on :5280+N (./data-N) — N up to 16 keeps the top port at 5296,
# below the scratch floor of 5297. All share a local discovery folder so post-adoption background
# sync can find addresses. N=1 is a bare `start`; the default N=3 is a `start-three`. Create a
# persona at :5281, register fresh accounts at the others, carry the codes between tabs. (On the
# ringtome-alt twin checkout every port is +500 - see port_offset.)
start-n n="3": ui-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"

    n="{{n}}"
    if ! [[ "$n" =~ ^[0-9]+$ ]] || [ "$n" -lt 1 ] || [ "$n" -gt 16 ]; then
        echo "start-n: n must be an integer from 1 to 16 (got '$n')" >&2
        exit 1
    fi

    # Shared local discovery so post-adoption background sync can find addresses. A lone node
    # (n=1) has no peers to find, so it goes bare like `just start`.
    discovery="local:./data-dht"
    [ "$n" -ge 2 ] || discovery=""

    # ensure esbuild output dirs exist
    mkdir -p node/js/target/js node/js/target/css

    # initial build so the servers have bundles to include_str! on first compile
    cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --sourcemap --keep-names && \
                  npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'
    cd "{{workspace}}"

    # JS watcher
    (cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser \
        --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" \
        --log-level=info --legal-comments=inline) &
    JS_PID=$!

    # CSS watcher
    (cd node/js && npx esbuild index.css --bundle --outfile=target/css/bundle.css \
        --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch) &
    CSS_PID=$!

    # Build once so the N `cargo run`s below don't race the compiler.
    cargo build --bin ringtome

    # Nodes 2..N in the background, logs to /tmp (their terminal noise would interleave with A's).
    node_pids=""
    for ((i = 2; i <= n; i++)); do
        port=$((5280 + i + {{port_offset}}))
        RINGTOME_PORT="$port" RINGTOME_DATA_DIRECTORY="./data-$i" RINGTOME_NODE_NAME="node-$i" \
            RINGTOME_DISCOVERY="$discovery" \
            cargo run --bin ringtome > "/tmp/ringtome-node-$i.log" 2>&1 &
        node_pids="$node_pids $!"
        echo "node $i (node-$i) on http://localhost:$port — data ./data-$i — logs: /tmp/ringtome-node-$i.log"
    done

    cleanup() {
        echo ""
        echo "shutting down..."
        kill "$JS_PID" "$CSS_PID" $node_pids 2>/dev/null || true
        wait "$JS_PID" "$CSS_PID" $node_pids 2>/dev/null || true
        echo "done."
    }
    trap cleanup EXIT

    # Node A on the dev port (plus the twin offset) in the foreground — Ctrl-C lands here and
    # takes everything down.
    RINGTOME_PORT=$((5281 + {{port_offset}})) RINGTOME_DISCOVERY="$discovery" cargo run --bin ringtome

# --- ui -----------------------------------------------------------------------

# Install JS dependencies for the Preact UI.
ui-install:
    cd "{{justfile_directory()}}/js" && npm install

# Production build of the Preact UI (JS + CSS bundles).
ui-build:
    cd "{{justfile_directory()}}/js" && mkdir -p target/js target/css && npx esbuild index.js --bundle --tree-shaking=true --metafile=target/js/meta.json --outfile=target/js/bundle.js --platform=browser --minify && npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'

# Watch-rebuild the JS bundle on save (run in a separate terminal).
ui-watch:
    cd "{{justfile_directory()}}/js" && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" --log-level=info --legal-comments=inline

# The JS-side gate: rebuild the bundles, then run the UI's pure-module tests.
#
# Rebuilding is half the value. esbuild is the only thing type-checking the UI - there is no
# tsc and (yet) no eslint - and `src/ui.rs` bakes the bundles in with `include_str!` while
# `js/target/` is gitignored, so until this has run NOTHING Rust compiles on a fresh clone and a
# stale bundle silently compiles on an old one. That is why the GitHub action builds the UI before
# `just ci`, and why `ci` now depends on this instead of assuming someone did.
#
# `integration/test/pure/` is the home for tests that need nothing - no browser, no node, no HTTP -
# which is exactly the UI's pure core. Living in their own directory means this gate is glob-driven:
# a new pure-module test is picked up by existing there, never by being added to a list here. (They
# also still run inside the full integration suite, whose `test/**/*.cjs` spec reaches them.)
#
# `--no-config` is required: .mocharc.json's spec MERGES with CLI args rather than yielding to
# them, so without it this runs the whole suite against nodes nobody booted - the same trap
# `mainline-smoke` documents. The glob is quoted so mocha expands it, not the shell.
#
# What a glob CANNOT catch is a pure module nobody wrote a test for; that is the purity cop's job
# (REFACTOR_UI S1), and this recipe is where it will live.
ui-check: ui-build
    cd "{{justfile_directory()}}/js" && npx eslint .
    cd "{{justfile_directory()}}/integration" && npx mocha --no-config 'test/pure/*.cjs'

# Watch-rebuild the CSS bundle on save (run in a separate terminal).
ui-csswatch:
    cd "{{justfile_directory()}}/js" && npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch

# --- integration tests -----------------------------------------------------

# Install the JS integration-test dependencies.
integration-install:
    cd "{{justfile_directory()}}/integration" && npm install

# Populate the currently-running nodes with a vibrant fake network: N personas per booted
# node (default 15), each performing N actions (default 15) drawn from a weighted hat -
# public posts, follows and trust across nodes, private notebooks, spreading onto other
# nodes. Same seed, same network; credentials land in harness/testdata-state.json. Extend it
# by adding an entry to ACTIONS in harness/testdata.mjs.
#
# Seed a fake network onto the running nodes (see harness/testdata.mjs; extensible).
test-data personas="15" actions="15" seed="":
    #!/usr/bin/env bash
    set -uo pipefail
    # Preflight the interpreter BEFORE any parse: an old Node dies on modern syntax deep in a
    # dependency, and a stack trace from cssstyle is a riddle where a sentence would do.
    major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
    if [ "$major" -lt 18 ]; then
        echo "test-data needs Node 18+ (global fetch); found $(node --version 2>/dev/null || echo 'no node') at $(which node 2>/dev/null || echo '?')" >&2
        exit 1
    fi
    # Default to the dev network, shifted with the twin like the recipes that spawn the nodes -
    # otherwise the generator would reach into the OTHER checkout's network. An explicit
    # RINGTOME_TESTDATA_PORTS (e.g. scratch nodes) is always honored as given.
    if [ -z "${RINGTOME_TESTDATA_PORTS-}" ]; then
        RINGTOME_TESTDATA_PORTS="$((5281 + {{port_offset}})),$((5282 + {{port_offset}})),$((5283 + {{port_offset}}))"
        export RINGTOME_TESTDATA_PORTS
    fi
    cd "{{justfile_directory()}}/harness" && node testdata.mjs {{personas}} {{actions}} {{seed}}

# --- scratch nodes (agent/probe testing) ----------------------------------------------------
# Throwaway nodes for harness probes and agent testing, kept STRUCTURALLY apart from the dev
# network: they refuse the dev ports (5281-5296), live in /tmp, and are killed by PID file -
# never by pattern - so no scratch cleanup can ever take down `just start*`. Born from the
# 2026-08-05 incident where a broad pkill killed the running dev trio mid-test and a scratch
# node then squatted 5281 impersonating it.

# Boot a throwaway node on a scratch port (5297-5299), wait for health, background it. The pid,
# data dir, log and discovery folder are all keyed by the port the node actually BINDS, which
# on the ringtome-alt twin is port+500 (see port_offset) - so the twins' scratch fixtures can
# never collide (their pidfiles stay distinct even at the same nominal port).
scratch port="5299":
    #!/usr/bin/env bash
    set -uo pipefail
    case "{{port}}" in
        5281|5282|5283|5284|5285|5286|5287|5288|5289|5290|5291|5292|5293|5294|5295|5296)
            echo "port {{port}} belongs to the dev network (just start*) - scratch uses 5297-5299" >&2
            exit 1;;
    esac
    port=$(({{port}} + {{port_offset}}))
    cd "{{workspace}}"
    dht="/tmp/ringtome-scratch-dht"
    [ "{{port_offset}}" -ne 0 ] && dht="${dht}{{port_offset}}"
    dir="/tmp/ringtome-scratch-$port"
    pidfile="$dir.pid"
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        echo "scratch node already up on :$port (pid $(cat "$pidfile"))"
        exit 0
    fi
    rm -rf "$dir"
    RINGTOME_PORT=$port RINGTOME_DATA_DIRECTORY="$dir" RINGTOME_LOCAL_TEST=1         RINGTOME_DISCOVERY="local:$dht" RINGTOME_SYNC_DEBOUNCE_MS=250         cargo run --bin ringtome > "$dir.log" 2>&1 &
    echo $! > "$pidfile"
    for i in $(seq 1 120); do
        if curl -s -o /dev/null -m 1 "http://localhost:$port/health"; then
            echo "scratch node on :$port (pid $(cat "$pidfile"), data $dir, log $dir.log)"
            exit 0
        fi
        sleep 1
    done
    echo "scratch node on :$port never became healthy - see $dir.log" >&2
    exit 1

# Kill every scratch node - by recorded PID only, so a running dev network cannot be touched.
scratch-kill:
    #!/usr/bin/env bash
    set -uo pipefail
    found=0
    for pidfile in /tmp/ringtome-scratch-*.pid; do
        [ -e "$pidfile" ] || continue
        found=1
        pid=$(cat "$pidfile")
        if kill "$pid" 2>/dev/null; then
            for i in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
            echo "killed scratch pid $pid ($pidfile)"
        else
            echo "scratch pid $pid already gone ($pidfile)"
        fi
        rm -f "$pidfile"
    done
    rm -rf /tmp/ringtome-scratch-* 2>/dev/null || true
    [ "$found" = 1 ] || echo "no scratch nodes recorded"

# MACHINE-WIDE BY DESIGN: takes down scratch nodes AND a running dev network alike (`just
# integration` depends on it, so an integration run does too). Probe cleanup wants
# `scratch-kill` instead, which cannot reach the dev network.
#
# Kill EVERY running ringtome, dev network included (see above; scratch-kill is the scoped one).
kill:
    -MSYS2_ARG_CONV_EXCL="*" taskkill -F -IM ringtome.exe 2>/dev/null || pkill -f 'target/debug/ringtome' 2>/dev/null || true

# DESTROY every development database on this machine, and the keys that open them.
#
# This is not "clean the build" - `cargo clean` is that. This deletes the data directories the
# dev recipes write to, which means accounts, personas, their chains, their journals, their
# blobs, and the keystore. Nothing survives it and nothing recovers it: the keystore is what
# decrypts the databases, so removing them together is the only honest option - a database
# without its key refuses to open, on purpose.
#
# What it is FOR: the node refuses to boot after a schema generation bump ("pre-launch there is
# no in-place migration - delete the database and rebuild"). This is that delete.
#
# Covers `start` / `run` (./data, which also contains the integration rig's ./data/test*),
# `start-two` (adds ./data-b, ./data-dht), `start-three` (adds ./data-c) and `start-n` (adds
# ./data-2.. ./data-N, all swept by the data-* glob). Kills any running
# node first, so nothing is holding a file open while it disappears.
#
# DESTROYS every dev persona, key and chain - the wipe a schema generation bump asks for.
clean: kill
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    for d in data data-*; do
        if [ -e "$d" ]; then
            rm -rf "$d" && echo "removed $d"
        fi
    done
    echo "gone: every persona, key and chain the dev nodes held. The next boot starts empty."

# Boot THREE throwaway nodes (sync tests need a peer; daisy-chain tests need a chain), wait for
# health, run the JS integration suite, tear all down. Single-node-only tests are unaffected;
# multi-node tests skip themselves if RINGTOME_TEST_HOST_B / _C are absent.
integration: build kill
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    rm -rf "{{test_data}}" "{{test_data}}-b" "{{test_data}}-c" "{{test_data}}-dht"
    # The twin-checkout offset (port_offset) applied to every bound port here.
    pa=$(( {{port}} + {{port_offset}} ))
    pb=$(( {{port_b}} + {{port_offset}} ))
    pc=$(( {{port_c}} + {{port_offset}} ))
    # Fast eager-push debounce so eagersync.cjs observes propagation quickly; the anti-entropy
    # interval deliberately stays at its 5-minute default so the eager path is what gets tested.
    # The peer-derive beat keeps its recovery pace on purpose - its lag behind a revocation is
    # the strike's delivery window, and a fast beat races every strike test's choreography.
    # peerderive.cjs rings the beat itself via POST /test/derive when it wants to watch one.
    RINGTOME_PORT=$pa RINGTOME_DATA_DIRECTORY="{{test_data}}" RINGTOME_LOCAL_TEST=1 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        RINGTOME_SYNC_DEBOUNCE_MS=250 RINGTOME_NODE_NAME=alpha \
        ./target/debug/ringtome > /tmp/ringtome-integration.log 2>&1 &
    NODE_PID=$!
    RINGTOME_PORT=$pb RINGTOME_DATA_DIRECTORY="{{test_data}}-b" RINGTOME_LOCAL_TEST=1 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        RINGTOME_SYNC_DEBOUNCE_MS=250 RINGTOME_NODE_NAME=bravo \
        ./target/debug/ringtome > /tmp/ringtome-integration-b.log 2>&1 &
    NODE_B_PID=$!
    RINGTOME_PORT=$pc RINGTOME_DATA_DIRECTORY="{{test_data}}-c" RINGTOME_LOCAL_TEST=1 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        RINGTOME_SYNC_DEBOUNCE_MS=250 RINGTOME_NODE_NAME=charlie \
        ./target/debug/ringtome > /tmp/ringtome-integration-c.log 2>&1 &
    NODE_C_PID=$!
    cleanup() {
        if command -v taskkill >/dev/null 2>&1; then
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_B_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_C_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -IM ringtome.exe 2>/dev/null || true
        else
            kill "$NODE_PID" "$NODE_B_PID" "$NODE_C_PID" 2>/dev/null || true
        fi
    }
    trap cleanup EXIT

    # Wait up to ~10s for each node to answer /health.
    for p in $pa $pb $pc; do
        for i in $(seq 1 50); do
            if curl -sf "http://127.0.0.1:$p/health" >/dev/null 2>&1; then
                break
            fi
            sleep 0.2
            if [[ $i -eq 50 ]]; then
                echo "node on :$p did not become healthy; logs:" >&2
                cat /tmp/ringtome-integration.log /tmp/ringtome-integration-b.log /tmp/ringtome-integration-c.log >&2
                exit 1
            fi
        done
    done

    cd "{{justfile_directory()}}/integration"
    RINGTOME_TEST_HOST="127.0.0.1:$pa" RINGTOME_TEST_HOST_B="127.0.0.1:$pb" \
        RINGTOME_TEST_HOST_C="127.0.0.1:$pc" \
        RINGTOME_TEST_DISCOVERY_DIR="{{workspace}}/{{test_data}}-dht" npm test

# The mainline field test: two local nodes on RINGTOME_DISCOVERY=mainline, talking to the REAL
# public mainline DHT and n0 relay/DNS infrastructure. Seconds when that infrastructure is
# healthy (pkarr relays + n0 DNS answer in one round trip), with multi-minute retry ceilings for
# when it isn't; needs the open internet, and publishes throwaway records - including this
# machine's public IP - to the public DHT. On demand only (here or the dispatch-only GitHub
# action); never part of `just ci`.
# The test spawns and restarts its own node processes; see test/mainline.cjs for why.
mainline-smoke: build kill integration-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    rm -rf ./data/test-mainline
    cd node/integration
    # --no-config: .mocharc.json's test/**/* spec glob merges with (rather than yields to) CLI
    # file args, which would run the whole suite against nodes this recipe never booted.
    RINGTOME_TEST_MAINLINE=1 RINGTOME_PORT_OFFSET={{port_offset}} npx mocha --no-config test/mainline.cjs --timeout 900000

# --- everything ------------------------------------------------------------

# Full local check: UI bundles + UI pure tests, then cargo check, clippy, Rust unit tests, and
# the integration suite. `ui-check` runs FIRST because the Rust build embeds its output.
ci: ui-check check lint test-unit integration
