# Ringtome node - common automation.
# Run `just` with no arguments to list recipes.

# Use bash for all recipes (this repo is developed under Git Bash on Windows).
set shell := ["bash", "-uc"]
# Don't let MSYS mangle Windows-style args (e.g. taskkill's -F/-IM).
set windows-shell := ["bash", "-uc"]

# Paths are relative to this justfile (the `node/` dir); step up for cargo commands.
workspace := justfile_directory() / ".."
port := env_var_or_default("RINGTOME_PORT", "5281")
port_b := env_var_or_default("RINGTOME_PORT_B", "5282")
port_c := env_var_or_default("RINGTOME_PORT_C", "5283")
test_data := "./data/test"

# When two copies of this repo run on one machine, every server port conflicts unless one twin
# clears out. This checkout declares itself the "alt" twin - its path contains "ringtome-alt" -
# so every port this justfile spawns a server on gets PORT+500: dev 5281.. -> 5781..,
# scratch 5297.. -> 5797.., the test_integration rig and the test-data defaults follow. The
# unmarked twin stays on the base ports. Relative invariants (dev's top < scratch's floor) hold
# under the shift too.
port_offset := `case "$PWD" in *ringtome-alt*) echo 500 ;; *) echo 0 ;; esac`

# List available recipes.
default:
    @just --list

# --- install ---------------------------------------------------------------

# Install every dependency the app needs to run (assumes node and rust already
# exist): npm packages for the UI and the integration harness, and the Rust
# workspace's crates via cargo fetch (downloads only - `just build` compiles).
install: ui-install integration-install
    cd "{{workspace}}" && cargo fetch

# --- build / check ---------------------------------------------------------

# Compile the workspace (debug).
build:
    cd "{{workspace}}" && cargo build

# Fast type-check without producing a binary.
check:
    cd "{{workspace}}" && cargo check

# Clippy lints, warnings-as-errors.
lint:
    cd "{{workspace}}" && cargo clippy -- -D warnings

# Format all Rust code.
fmt:
    cd "{{workspace}}" && cargo fmt

# Rust unit tests.
# Full output teed to /tmp so any failure's `failures:` block survives the run even when a
# pipe or scrolled terminal eats it. (Installed to hunt the once-in-many-runs phantom flake,
# which it caught on 2026-07-25: a temp-dir clock collision in db tests, since fixed. Kept -
# it costs nothing and the next phantom won't announce itself either.)
test-unit:
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    cargo test --no-fail-fast 2>&1 | tee /tmp/ringtome-test-unit.log
    exit "${PIPESTATUS[0]}"

# --- run -------------------------------------------------------------------

# Run the node in the foreground (Ctrl-C to stop). Uses the default data dir.
run:
    cd "{{workspace}}" && RINGTOME_PORT=$(( {{port}} + {{port_offset}} )) cargo run --bin ringtome

# Boot the server + UI watchers in one terminal. Ctrl-C tears everything down.
start: ui-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"

    # ensure esbuild output dirs exist
    mkdir -p node/js/target/js node/js/target/css

    # initial build so the server has bundles to include_str! on first compile
    cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --sourcemap --keep-names && \
                  npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'
    cd "{{workspace}}"

    # JS watcher
    (cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser \
        --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" \
        --log-level=info --legal-comments=inline) &
    JS_PID=$!

    # CSS watcher
    (cd node/js && npx esbuild index.css --bundle --outfile=target/css/bundle.css \
        --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch) &
    CSS_PID=$!

    cleanup() {
        echo ""
        echo "shutting down..."
        kill "$JS_PID" "$CSS_PID" 2>/dev/null || true
        wait "$JS_PID" "$CSS_PID" 2>/dev/null || true
        echo "done."
    }
    trap cleanup EXIT

    # Rust server (foreground — Ctrl-C lands here first), on the dev port plus the twin offset.
    RINGTOME_PORT=$((5281 + {{port_offset}})) cargo run --bin ringtome

# Two dev nodes on one machine, one Ctrl-C: the adoption-ceremony playground. Node A on :5281
# (default data dir, hostname name), node B on :5282 (./data-b, named "second-brain"), sharing
# a local discovery folder so post-adoption background sync can find addresses. Create a
# persona at :5281, register a fresh account at :5282, carry the codes between tabs. (On the
# ringtome-alt twin checkout every port is +500 - see port_offset.)
start-two: ui-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"

    mkdir -p node/js/target/js node/js/target/css

    # initial build so the servers have bundles to include_str! on first compile
    cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --sourcemap --keep-names && \
                  npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'
    cd "{{workspace}}"

    # JS watcher
    (cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser \
        --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" \
        --log-level=info --legal-comments=inline) &
    JS_PID=$!

    # CSS watcher
    (cd node/js && npx esbuild index.css --bundle --outfile=target/css/bundle.css \
        --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch) &
    CSS_PID=$!

    # Build once so the two `cargo run`s below don't race the compiler.
    cargo build --bin ringtome

    # Node B in the background, logs to /tmp (its terminal noise would interleave with A's).
    node_b_port=$((5282 + {{port_offset}}))
    RINGTOME_PORT="$node_b_port" RINGTOME_DATA_DIRECTORY=./data-b RINGTOME_NODE_NAME=second-brain \
        RINGTOME_DISCOVERY=local:./data-dht \
        cargo run --bin ringtome > /tmp/ringtome-second-brain.log 2>&1 &
    NODE_B_PID=$!
    echo "node B (second-brain) on http://localhost:$node_b_port — logs: /tmp/ringtome-second-brain.log"

    cleanup() {
        echo ""
        echo "shutting down..."
        kill "$JS_PID" "$CSS_PID" "$NODE_B_PID" 2>/dev/null || true
        wait "$JS_PID" "$CSS_PID" "$NODE_B_PID" 2>/dev/null || true
        echo "done."
    }
    trap cleanup EXIT

    # Node A on the dev port (plus the twin offset) in the foreground — Ctrl-C lands here and
    # takes everything down.
    RINGTOME_PORT=$((5281 + {{port_offset}})) RINGTOME_DISCOVERY=local:./data-dht cargo run --bin ringtome

# Three dev nodes, one Ctrl-C: the daisy-chain playground. A on :5281 (hostname name),
# B "second-brain" on :5282 (./data-b), C "third-brain" on :5283 (./data-c), shared local
# discovery. Found a persona on A, invite B from A, then invite C *from B* - the un-trimmed
# junior grant: the chain of computers doesn't route through the founder. (On the ringtome-alt
# twin checkout every port is +500 - see port_offset.)
start-three: ui-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"

    mkdir -p node/js/target/js node/js/target/css

    # initial build so the servers have bundles to include_str! on first compile
