# Ringtome node - common automation.
# Run `just` with no arguments to list recipes.

# Use bash for all recipes (this repo is developed under Git Bash on Windows).
set shell := ["bash", "-uc"]
# Don't let MSYS mangle Windows-style args (e.g. taskkill's -F/-IM).
set windows-shell := ["bash", "-uc"]

# Paths are relative to this justfile (the `node/` dir); step up for cargo commands.
workspace := justfile_directory() / ".."
port := env_var_or_default("RINGTOME_PORT", "5281")
port_b := env_var_or_default("RINGTOME_PORT_B", "5282")
port_c := env_var_or_default("RINGTOME_PORT_C", "5283")
test_data := "./data/test"

# List available recipes.
default:
    @just --list

# --- build / check ---------------------------------------------------------

# Compile the workspace (debug).
build:
    cd "{{workspace}}" && cargo build

# Fast type-check without producing a binary.
check:
    cd "{{workspace}}" && cargo check

# Clippy lints, warnings-as-errors.
lint:
    cd "{{workspace}}" && cargo clippy -- -D warnings

# Format all Rust code.
fmt:
    cd "{{workspace}}" && cargo fmt

# Rust unit tests.
# Full output teed to /tmp so any failure's `failures:` block survives the run even when a
# pipe or scrolled terminal eats it. (Installed to hunt the once-in-many-runs phantom flake,
# which it caught on 2026-07-25: a temp-dir clock collision in db tests, since fixed. Kept -
# it costs nothing and the next phantom won't announce itself either.)
test-unit:
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    cargo test --no-fail-fast 2>&1 | tee /tmp/ringtome-test-unit.log
    exit "${PIPESTATUS[0]}"

# --- run -------------------------------------------------------------------

# Run the node in the foreground (Ctrl-C to stop). Uses the default data dir.
run:
    cd "{{workspace}}" && cargo run --bin ringtome

# Boot the server + UI watchers in one terminal. Ctrl-C tears everything down.
start: ui-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"

    # ensure esbuild output dirs exist
    mkdir -p node/js/target/js node/js/target/css

    # initial build so the server has bundles to include_str! on first compile
    cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --sourcemap --keep-names && \
                  npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'
    cd "{{workspace}}"

    # JS watcher
    (cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser \
        --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" \
        --log-level=info --legal-comments=inline) &
    JS_PID=$!

    # CSS watcher
    (cd node/js && npx esbuild index.css --bundle --outfile=target/css/bundle.css \
        --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch) &
    CSS_PID=$!

    cleanup() {
        echo ""
        echo "shutting down..."
        kill "$JS_PID" "$CSS_PID" 2>/dev/null || true
        wait "$JS_PID" "$CSS_PID" 2>/dev/null || true
        echo "done."
    }
    trap cleanup EXIT

    # Rust server (foreground — Ctrl-C lands here first)
    cargo run --bin ringtome

# Two dev nodes on one machine, one Ctrl-C: the adoption-ceremony playground. Node A on :5281
# (default data dir, hostname name), node B on :5282 (./data-b, named "second-brain"), sharing
# a local discovery folder so post-adoption background sync can find addresses. Create a
# persona at :5281, register a fresh account at :5282, carry the codes between tabs.
start_two: ui-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"

    mkdir -p node/js/target/js node/js/target/css

    # initial build so the servers have bundles to include_str! on first compile
    cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --sourcemap --keep-names && \
                  npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'
    cd "{{workspace}}"

    # JS watcher
    (cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser \
        --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" \
        --log-level=info --legal-comments=inline) &
    JS_PID=$!

    # CSS watcher
    (cd node/js && npx esbuild index.css --bundle --outfile=target/css/bundle.css \
        --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch) &
    CSS_PID=$!

    # Build once so the two `cargo run`s below don't race the compiler.
    cargo build --bin ringtome

    # Node B in the background, logs to /tmp (its terminal noise would interleave with A's).
    RINGTOME_PORT=5282 RINGTOME_DATA_DIRECTORY=./data-b RINGTOME_NODE_NAME=second-brain \
        RINGTOME_DISCOVERY=local:./data-dht \
        cargo run --bin ringtome > /tmp/ringtome-second-brain.log 2>&1 &
    NODE_B_PID=$!
    echo "node B (second-brain) on http://localhost:5282 — logs: /tmp/ringtome-second-brain.log"

    cleanup() {
        echo ""
        echo "shutting down..."
        kill "$JS_PID" "$CSS_PID" "$NODE_B_PID" 2>/dev/null || true
        wait "$JS_PID" "$CSS_PID" "$NODE_B_PID" 2>/dev/null || true
        echo "done."
    }
    trap cleanup EXIT

    # Node A in the foreground — Ctrl-C lands here and takes everything down.
    RINGTOME_DISCOVERY=local:./data-dht cargo run --bin ringtome

# Three dev nodes, one Ctrl-C: the daisy-chain playground. A on :5281 (hostname name),
# B "second-brain" on :5282 (./data-b), C "third-brain" on :5283 (./data-c), shared local
# discovery. Found a persona on A, invite B from A, then invite C *from B* - the un-trimmed
# junior grant: the chain of computers doesn't route through the founder.
start_three: ui-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"

    mkdir -p node/js/target/js node/js/target/css

    # initial build so the servers have bundles to include_str! on first compile
    cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --sourcemap --keep-names && \
                  npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'
    cd "{{workspace}}"

    # JS watcher
    (cd node/js && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser \
        --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" \
        --log-level=info --legal-comments=inline) &
    JS_PID=$!

    # CSS watcher
    (cd node/js && npx esbuild index.css --bundle --outfile=target/css/bundle.css \
        --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch) &
    CSS_PID=$!

    # Build once so the three `cargo run`s below don't race the compiler.
    cargo build --bin ringtome

    RINGTOME_PORT=5282 RINGTOME_DATA_DIRECTORY=./data-b RINGTOME_NODE_NAME=second-brain \
        RINGTOME_DISCOVERY=local:./data-dht \
        cargo run --bin ringtome > /tmp/ringtome-second-brain.log 2>&1 &
    NODE_B_PID=$!
    echo "node B (second-brain) on http://localhost:5282 — logs: /tmp/ringtome-second-brain.log"

    RINGTOME_PORT=5283 RINGTOME_DATA_DIRECTORY=./data-c RINGTOME_NODE_NAME=third-brain \
        RINGTOME_DISCOVERY=local:./data-dht \
        cargo run --bin ringtome > /tmp/ringtome-third-brain.log 2>&1 &
    NODE_C_PID=$!
    echo "node C (third-brain) on http://localhost:5283 — logs: /tmp/ringtome-third-brain.log"

    cleanup() {
        echo ""
        echo "shutting down..."
        kill "$JS_PID" "$CSS_PID" "$NODE_B_PID" "$NODE_C_PID" 2>/dev/null || true
        wait "$JS_PID" "$CSS_PID" "$NODE_B_PID" "$NODE_C_PID" 2>/dev/null || true
        echo "done."
    }
    trap cleanup EXIT

    # Node A in the foreground — Ctrl-C lands here and takes everything down.
    RINGTOME_DISCOVERY=local:./data-dht cargo run --bin ringtome

# --- ui -----------------------------------------------------------------------

# Install JS dependencies for the Preact UI.
ui-install:
    cd "{{justfile_directory()}}/js" && npm install

# Production build of the Preact UI (JS + CSS bundles).
ui-build:
    cd "{{justfile_directory()}}/js" && mkdir -p target/js target/css && npx esbuild index.js --bundle --tree-shaking=true --metafile=target/js/meta.json --outfile=target/js/bundle.js --platform=browser --minify && npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png'

# Watch-rebuild the JS bundle on save (run in a separate terminal).
ui-watch:
    cd "{{justfile_directory()}}/js" && npx esbuild index.js --bundle --outfile=target/js/bundle.js --platform=browser --watch --sourcemap --keep-names --define:process.env.NODE_ENV=\"development\" --log-level=info --legal-comments=inline

# The JS-side gate: rebuild the bundles, then run the UI's pure-module tests.
#
# Rebuilding is half the value. esbuild is the only thing type-checking the UI - there is no
# tsc and (yet) no eslint - and `src/ui.rs` bakes the bundles in with `include_str!` while
# `js/target/` is gitignored, so until this has run NOTHING Rust compiles on a fresh clone and a
# stale bundle silently compiles on an old one. That is why the GitHub action builds the UI before
# `just ci`, and why `ci` now depends on this instead of assuming someone did.
#
# The four test files below ARE the UI's pure core - no imports from `js/`, no DOM, no fetch, no
# node to boot - and a new pure-module test belongs in this list (it also runs inside the full
# integration suite either way, via mocha's spec glob). `--no-config` is required: .mocharc.json's
# `test/**/*.cjs` spec MERGES with CLI file args rather than yielding to them, so without it this
# runs the whole suite against nodes nobody booted - the same trap `mainline-smoke` documents.
ui-check: ui-build
    cd "{{justfile_directory()}}/integration" && npx mocha --no-config test/lookout.cjs test/keepalive.cjs test/docdate.cjs test/search.cjs

# Watch-rebuild the CSS bundle on save (run in a separate terminal).
ui-csswatch:
    cd "{{justfile_directory()}}/js" && npx esbuild index.css --bundle --outfile=target/css/bundle.css --external:'*.woff2' --external:'*.woff' --external:'*.ttf' --external:'*.png' --watch

# --- integration tests -----------------------------------------------------

# Install the JS integration-test dependencies.
integration-install:
    cd "{{justfile_directory()}}/integration" && npm install

# Kill any running ringtome (Windows or POSIX), ignoring "not found".
kill:
    -MSYS2_ARG_CONV_EXCL="*" taskkill -F -IM ringtome.exe 2>/dev/null || pkill -f 'target/debug/ringtome' 2>/dev/null || true

# Boot THREE throwaway nodes (sync tests need a peer; daisy-chain tests need a chain), wait for
# health, run the JS integration suite, tear all down. Single-node-only tests are unaffected;
# multi-node tests skip themselves if RINGTOME_TEST_HOST_B / _C are absent.
integration: build kill
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    rm -rf "{{test_data}}" "{{test_data}}-b" "{{test_data}}-c" "{{test_data}}-dht"
    # Fast eager-push debounce so eagersync.cjs observes propagation quickly; the anti-entropy
    # interval deliberately stays at its 5-minute default so the eager path is what gets tested.
    RINGTOME_PORT={{port}} RINGTOME_DATA_DIRECTORY="{{test_data}}" RINGTOME_LOCAL_TEST=1 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        RINGTOME_SYNC_DEBOUNCE_MS=250 RINGTOME_NODE_NAME=alpha \
        ./target/debug/ringtome > /tmp/ringtome-integration.log 2>&1 &
    NODE_PID=$!
    RINGTOME_PORT={{port_b}} RINGTOME_DATA_DIRECTORY="{{test_data}}-b" RINGTOME_LOCAL_TEST=1 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        RINGTOME_SYNC_DEBOUNCE_MS=250 RINGTOME_NODE_NAME=bravo \
        ./target/debug/ringtome > /tmp/ringtome-integration-b.log 2>&1 &
    NODE_B_PID=$!
    RINGTOME_PORT={{port_c}} RINGTOME_DATA_DIRECTORY="{{test_data}}-c" RINGTOME_LOCAL_TEST=1 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        RINGTOME_SYNC_DEBOUNCE_MS=250 RINGTOME_NODE_NAME=charlie \
        ./target/debug/ringtome > /tmp/ringtome-integration-c.log 2>&1 &
    NODE_C_PID=$!
    cleanup() {
        if command -v taskkill >/dev/null 2>&1; then
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_B_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_C_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -IM ringtome.exe 2>/dev/null || true
        else
            kill "$NODE_PID" "$NODE_B_PID" "$NODE_C_PID" 2>/dev/null || true
        fi
    }
    trap cleanup EXIT

    # Wait up to ~10s for each node to answer /health.
    for p in {{port}} {{port_b}} {{port_c}}; do
        for i in $(seq 1 50); do
            if curl -sf "http://127.0.0.1:$p/health" >/dev/null 2>&1; then
                break
            fi
            sleep 0.2
            if [[ $i -eq 50 ]]; then
                echo "node on :$p did not become healthy; logs:" >&2
                cat /tmp/ringtome-integration.log /tmp/ringtome-integration-b.log /tmp/ringtome-integration-c.log >&2
                exit 1
            fi
        done
    done

    cd "{{justfile_directory()}}/integration"
    RINGTOME_TEST_HOST="127.0.0.1:{{port}}" RINGTOME_TEST_HOST_B="127.0.0.1:{{port_b}}" \
        RINGTOME_TEST_HOST_C="127.0.0.1:{{port_c}}" \
        RINGTOME_TEST_DISCOVERY_DIR="{{workspace}}/{{test_data}}-dht" npm test

# The mainline field test: two local nodes on RINGTOME_DISCOVERY=mainline, talking to the REAL
# public mainline DHT and n0 relay/DNS infrastructure. Seconds when that infrastructure is
# healthy (pkarr relays + n0 DNS answer in one round trip), with multi-minute retry ceilings for
# when it isn't; needs the open internet, and publishes throwaway records - including this
# machine's public IP - to the public DHT. On demand only (here or the dispatch-only GitHub
# action); never part of `just ci`.
# The test spawns and restarts its own node processes; see test/mainline.cjs for why.
mainline-smoke: build kill integration-install
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    rm -rf ./data/test-mainline
    cd node/integration
    # --no-config: .mocharc.json's test/**/* spec glob merges with (rather than yields to) CLI
    # file args, which would run the whole suite against nodes this recipe never booted.
    RINGTOME_TEST_MAINLINE=1 npx mocha --no-config test/mainline.cjs --timeout 900000

# --- everything ------------------------------------------------------------

# Full local check: UI bundles + UI pure tests, then cargo check, clippy, Rust unit tests, and
# the integration suite. `ui-check` runs FIRST because the Rust build embeds its output.
ci: ui-check check lint test-unit integration
