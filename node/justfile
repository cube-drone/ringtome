    NODE_B_PID=$!
    echo "node B (second-brain) on http://localhost:$node_b_port — logs: /tmp/ringtome-second-brain.log"

    node_c_port=$((5283 + {{port_offset}}))
    RINGTOME_PORT="$node_c_port" RINGTOME_DATA_DIRECTORY=./data-c RINGTOME_NODE_NAME=third-brain \
        RINGTOME_DISCOVERY=local:./data-dht \
        cargo run --bin ringtome > /tmp/ringtome-third-brain.log 2>&1 &
