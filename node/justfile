# Ringtome node - common automation.
# Run `just` with no arguments to list recipes.

# Use bash for all recipes (this repo is developed under Git Bash on Windows).
set shell := ["bash", "-uc"]
# Don't let MSYS mangle Windows-style args (e.g. taskkill's -F/-IM).
set windows-shell := ["bash", "-uc"]

# Paths are relative to this justfile (the `node/` dir); step up for cargo commands.
workspace := justfile_directory() / ".."
port := env_var_or_default("RINGTOME_PORT", "5281")
port_b := env_var_or_default("RINGTOME_PORT_B", "5282")
test_data := "./data/test"

# List available recipes.
default:
    @just --list

# --- build / check ---------------------------------------------------------

# Compile the workspace (debug).
build:
    cd "{{workspace}}" && cargo build

# Fast type-check without producing a binary.
check:
    cd "{{workspace}}" && cargo check

# Clippy lints, warnings-as-errors.
lint:
    cd "{{workspace}}" && cargo clippy -- -D warnings

# Format all Rust code.
fmt:
    cd "{{workspace}}" && cargo fmt

# Rust unit tests.
test-unit:
    cd "{{workspace}}" && cargo test

# --- run -------------------------------------------------------------------

# Run the node in the foreground (Ctrl-C to stop). Uses the default data dir.
run:
    cd "{{workspace}}" && cargo run --bin ringtome

# --- integration tests -----------------------------------------------------

# Install the JS integration-test dependencies.
integration-install:
    cd "{{justfile_directory()}}/integration" && npm install

# Kill any running ringtome (Windows or POSIX), ignoring "not found".
kill:
    -MSYS2_ARG_CONV_EXCL="*" taskkill -F -IM ringtome.exe 2>/dev/null || pkill -f 'target/debug/ringtome' 2>/dev/null || true

# Boot TWO throwaway nodes (sync tests need a peer), wait for health, run the JS integration
# suite, tear both down. Single-node-only tests are unaffected; two-node tests skip themselves
# if RINGTOME_TEST_HOST_B is absent.
integration: build kill
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{workspace}}"
    rm -rf "{{test_data}}" "{{test_data}}-b" "{{test_data}}-dht"
    RINGTOME_PORT={{port}} RINGTOME_DATA_DIRECTORY="{{test_data}}" RINGTOME_LOCAL_TEST=1 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        ./target/debug/ringtome > /tmp/ringtome-integration.log 2>&1 &
    NODE_PID=$!
    RINGTOME_PORT={{port_b}} RINGTOME_DATA_DIRECTORY="{{test_data}}-b" RINGTOME_LOCAL_TEST=1 \
        RINGTOME_DISCOVERY="local:{{test_data}}-dht" RINGTOME_MAX_UPLOAD_BYTES=1048576 RINGTOME_MAX_DOCUMENT_BYTES=262144 \
        ./target/debug/ringtome > /tmp/ringtome-integration-b.log 2>&1 &
    NODE_B_PID=$!
    cleanup() {
        if command -v taskkill >/dev/null 2>&1; then
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -PID "$NODE_B_PID" 2>/dev/null || true
            MSYS2_ARG_CONV_EXCL="*" taskkill -F -IM ringtome.exe 2>/dev/null || true
        else
            kill "$NODE_PID" "$NODE_B_PID" 2>/dev/null || true
        fi
    }
    trap cleanup EXIT

    # Wait up to ~10s for each node to answer /health.
    for p in {{port}} {{port_b}}; do
        for i in $(seq 1 50); do
            if curl -sf "http://127.0.0.1:$p/health" >/dev/null 2>&1; then
                break
            fi
            sleep 0.2
            if [[ $i -eq 50 ]]; then
                echo "node on :$p did not become healthy; logs:" >&2
                cat /tmp/ringtome-integration.log /tmp/ringtome-integration-b.log >&2
                exit 1
            fi
        done
    done

    cd "{{justfile_directory()}}/integration"
    RINGTOME_TEST_HOST="127.0.0.1:{{port}}" RINGTOME_TEST_HOST_B="127.0.0.1:{{port_b}}" \
        RINGTOME_TEST_DISCOVERY_DIR="{{workspace}}/{{test_data}}-dht" npm test

# --- everything ------------------------------------------------------------

# Full local check: format check, lint, unit tests, integration tests.
ci: check lint test-unit integration
